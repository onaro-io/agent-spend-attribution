{
  "name": "oasa-spec-tools",
  "private": true,
  "description": "Schema generation and example validation for the OASA specification.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate": "node scripts/generate-schema.mjs",
    "check:schema": "node scripts/generate-schema.mjs --check",
    "validate": "node scripts/validate.mjs",
    "publish-schema": "node scripts/publish-schema.mjs",
    "check:published": "node scripts/check-published-schema.mjs",
    "check:published:live": "node scripts/check-published-schema.mjs --live",
    "test": "npm run check:schema && npm run validate && npm run check:published"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}
